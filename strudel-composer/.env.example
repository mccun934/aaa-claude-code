# Required: your Anthropic API key
ANTHROPIC_API_KEY=
# Optional overrides
# STRUDEL_MODEL=claude-opus-5-5
# STRUDEL_EFFORT=high            # low | medium | high | xhigh | max
# STRUDEL_MAX_STEPS=40           # max tool-use steps per chat message
# STRUDEL_FALLBACKS=1            # server-side refusal fallbacks (Claude API only)
# PASS_SCORE=70                  # musicality pass mark used by the agent's publish gate
# PORT=5174
# CHROMIUM_PATH=/path/to/chromium  # if Playwright's browser isn't installed

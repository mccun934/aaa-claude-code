# No API key needed: the terminal runs your own Claude Code login.
# Optional overrides:
# PORT=5174
# HOST=127.0.0.1                  # keep the terminal local; it is a real shell
# PASS_SCORE=70                   # musicality pass mark for publish
# STRUDEL_WELCOME="..."           # first message sent to Claude when the terminal opens
# STRUDEL_TERMINAL_CMD='claude --model sonnet "$STRUDEL_WELCOME"'   # replace the whole terminal command
# CHROMIUM_PATH=/path/to/chromium # if Playwright's browser isn't installed

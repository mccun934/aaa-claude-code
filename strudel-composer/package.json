{
  "name": "strudel-composer",
  "version": "0.1.0",
  "private": true,
  "description": "Compose music in Strudel with Claude Code in a web terminal; songs are tested for musicality and auto-load into a live editor.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "strudel": "node scripts/strudel.mjs",
    "ingest": "node scripts/ingest.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "@strudel/repl": "1.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "ws": "^8.22.0"
  }
}
